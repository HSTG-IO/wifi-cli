# Installed by wifi-cli. Lets systemd-networkd DHCP any wireless interface once
# wpa_supplicant@<iface> has associated. The route metric is above every common
# wired default (systemd-networkd 1024, NetworkManager and netplan 100), so a
# plugged-in Ethernet cable still wins the default route; lower wins.
[Match]
Type=wlan

[Network]
DHCP=yes
IPv6AcceptRA=yes

[DHCP]
RouteMetric=2048
UseDomains=yes
