# Installed by wifi-cli. Lets systemd-networkd DHCP any wireless interface once
# wpa_supplicant@<iface> has associated. Higher route metric than typical wired
# (100–1024 default; most wired links land at 1024 but Ubuntu's netplan often
# sets 100) so a plugged-in Ethernet cable still wins for the default route.
[Match]
Type=wlan

[Network]
DHCP=yes
IPv6AcceptRA=yes

[DHCP]
RouteMetric=600
UseDomains=yes
